{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // ES2024 for Promise.withResolvers (src/main/updater.ts). Safe: the main process runs
    // on Electron's bundled Node 22 / V8 12, which has it. `target` stays ES2022 — this
    // only widens the ambient types, it does not change what tsc emits.
    "lib": ["ES2024", "DOM"],
    "types": ["node"]
  },
  "include": ["src/main/**/*.ts", "src/shared/**/*.ts"]
}
